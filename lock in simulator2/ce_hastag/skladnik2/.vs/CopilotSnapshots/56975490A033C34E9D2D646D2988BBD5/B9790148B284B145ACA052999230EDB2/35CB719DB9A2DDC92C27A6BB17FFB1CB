using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace sklad
{
    internal class Program
    {
        static int Skladnik()
        {
            char[,] roomMap = new char[10, 10];

            int[] start = new int[2];
            int[] end = new int[2];
            int[] box = new int[2];

            for (int i = 0; i < 10; i++)
            {
                for (int j = 0; j <= 10; j++)
                {
                    char position = (char) Console.Read();   

                    switch (position)
                    {
                        case '.':
                            roomMap[j, i] = '.';
                            break;
                        case 'X':
                            roomMap[j, i] = 'X';
                            break;
                        case 'C':
                            roomMap[j, i] = '.';
                            end[0] = j;
                            end[1] = i;
                            break;
                        case 'S':
                            roomMap[j, i] = '.';
                            start[0] = j;
                            start[1] = i;
                            break;
                        case 'B':
                            roomMap[j, i] = '.';
                            box[0] = j;
                            box[1] = i;
                            break;
                    }
                }
            }

            
            Queue<(int, int, int, int, int)> movesQueue = new Queue<(int, int, int, int, int)>();

            movesQueue.Enqueue((start[0], start[1], box[0], box[1], 0));


            while (movesQueue.Count() > 0)
            {
                (int currX, int currY, int boxX, int boxY, int currentMovesCount) = movesQueue.Dequeue();

                if ((boxX, boxY) == (end[0], end[1]))
                {
                    return currentMovesCount;
                }

                if ((boxX + 1 == 'X' && boxY + 1 == 'X') || (boxX - 1 == 'X' && boxY - 1 == 'X') || (boxX + 1 == 'X' && boxY - 1 == 'X') || (boxX - 1 == 'X' && boxY + 1 == 'X'))
                {
                    continue;
                }

                foreach ((int moveX, int moveY) in ((int, int)[])[(0, 1), (1, 0), (0, -1), (-1, 0)])
                {
                    int newX = currX + moveX;
                    int newY = currY + moveY;

                    if ((newX >= 0 && newX < 10 && newY >= 0 && newY < 10) && (boxX >= 0 && boxX < 10 && boxY >= 0 && boxY < 10))
                    {
                        if ((newX, newY) == (boxX, boxY))
                        {
                            boxX = boxX + moveX;
                            boxY = boxY + moveY;
                        }

                        //roomMap[newY, newX] = 'X';
                        movesQueue.Enqueue((newX, newY, boxX, boxY, currentMovesCount + 1));



                        }
                    }
            }

            return -1;
        }

        static void Main(string[] args)
        {
            Console.WriteLine(Skladnik());
        }
    }
}
